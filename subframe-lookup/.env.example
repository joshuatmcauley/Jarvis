# Copy to .env and fill in. Never commit real keys.

PORT=8787

# --- DVLA Vehicle Enquiry Service (free) ---
# Register: https://developer-portal.driver-vehicle-licensing.api.gov.uk/
DVLA_API_KEY=

# --- DVSA MOT history API (free, gives MODEL — important for fitment) ---
# Register: https://documentation.history.mot.api.gov.uk/mot-history-api/register
# You receive client id, secret, token URL, scope, and API key by email (can take a few working days).
MOT_CLIENT_ID=
MOT_CLIENT_SECRET=
MOT_API_KEY=
MOT_TOKEN_URL=
# Usually: https://tapi.dvsa.gov.uk/.default
MOT_SCOPE=https://tapi.dvsa.gov.uk/.default
